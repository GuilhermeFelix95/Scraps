<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Scraps.Application\Scraps.Application.csproj" />
    <ProjectReference Include="..\Scraps.Infrastructure\Scraps.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Copia as ferramentas de scripts/fetch-tools.ps1 para third-party/ ao lado do executável. Sem a pasta, nada é copiado. -->
  <ItemGroup>
    <None Include="..\..\third-party\**\*" Link="third-party\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\third-party')" />
  </ItemGroup>

</Project>
